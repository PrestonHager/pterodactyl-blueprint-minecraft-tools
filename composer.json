{
  "name": "pterodactyl/minecraft-tools",
  "description": "A Pterodactyl panel extension for managing Minecraft server utilities",
  "type": "pterodactyl-extension",
  "version": "1.0.0",
  "license": "MIT",
  "authors": [
    {
      "name": "Preston Hager",
      "email": "preston@example.com"
    }
  ],
  "require": {
    "php": "^8.1",
    "illuminate/support": "^10.0|^11.0",
    "illuminate/routing": "^10.0|^11.0",
    "illuminate/http": "^10.0|^11.0",
    "illuminate/view": "^10.0|^11.0",
    "illuminate/config": "^10.0|^11.0",
    "illuminate/filesystem": "^10.0|^11.0",
    "blueprint/extensions": "^1.0"
  },
  "require-dev": {
    "phpunit/phpunit": "^10.0",
    "mockery/mockery": "^1.6",
    "laravel/pint": "^1.14",
    "phpoption/phpoption": "^1.9",
    "vlucas/phpdotenv": "^5.6"
  },
  "autoload": {
    "psr-4": {
      "App\\Extensions\\MinecraftTools\\": "src/Extensions/MinecraftTools/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "App\\Extensions\\MinecraftTools\\Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": "phpunit",
    "test:unit": "phpunit --testsuite unit",
    "test:integration": "phpunit --testsuite integration",
    "lint": "pint",
    "lint:check": "pint --test"
  },
  "extra": {
    "pterodactyl": {
      "extension": {
        "class": "App\\Extensions\\MinecraftTools\\MinecraftTools",
        "provider": "App\\Extensions\\MinecraftTools\\MinecraftToolsServiceProvider"
      }
    }
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "repositories": [
    {
      "type": "path",
      "url": "stubs/blueprint-extensions-stub",
      "options": {
        "symlink": false
      }
    }
  ]
}